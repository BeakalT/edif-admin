# Copy to .env.production and fill in. Never commit the real file.
NODE_ENV=production
SITE_URL=https://www.edif.gov.et                 # must be https in production
PAYLOAD_SECRET=                                  # 32+ random characters: openssl rand -hex 32
DATABASE_URL=postgres://edif:CHANGE@db:5432/edif # PostgreSQL; a file: URL means SQLite (demo only)
DB_POOL_MAX=10

# Lets the deploy pipeline refresh pages right after a release (32+ random characters). Empty = endpoint off.
REVALIDATE_TOKEN=

# Admin location. Run `npm run set-admin-path -- <word>` before building so the folder matches.
ADMIN_PATH=/admin

# Where the real visitor address comes from. Count the proxies/CDNs in front of the app.
TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=cf-connecting-ip              # use instead if your CDN sets one trusted header

# Mail (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@edif.gov.et

# Uploads: leave S3_BUCKET empty to keep files on the local media volume
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Runtime folders (mount persistent volumes here)
DATA_DIR=/app/data
BACKUP_DIR=/app/backups

# Optional virus scanning of uploads (ClamAV daemon)
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# Backup retention: every backup for N days, one per week for N weeks, one per month for N months
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Email updates (newsletter) are hidden for now. To bring them back set this to on and rebuild.
NEXT_PUBLIC_NEWSLETTER=off
